<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.banking</groupId>
        <artifactId>banking-webclient-netty</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>payment-service</artifactId>
    <name>Payment Service — WebClient + Reactor Netty + mTLS</name>

    <dependencies>
        <!--
            spring-boot-starter-webflux brings:
            - WebClient (the API abstraction layer)
            - Reactor Netty (the underlying NIO HTTP engine)
            - Project Reactor (Mono / Flux types)
            NO separate Netty dependency needed — it's bundled with webflux.
        -->
        <!-- Parent POM already includes webflux -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Netty-specific TLS extras — gives us SslContextBuilder
            from io.netty.handler.ssl package (different from JDK SSLContext).
            This is the KEY difference vs Apache HC5 which uses JDK SSLContext.
        -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-tcnative-boringssl-static</artifactId>
            <classifier>linux-x86_64</classifier>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
